<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\Unskip.Core\Unskip.Core.csproj" />
    <ProjectReference Include="..\Unskip.Infrastructure.Persistence\Unskip.Infrastructure.Persistence.csproj" />
    <ProjectReference Include="..\Unskip.Infrastructure.Windows\Unskip.Infrastructure.Windows.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <ApplicationIcon>Assets\unskip.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF owns per-monitor DPI through app.manifest; WinForms is used only for NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets\unskip.ico" />
  </ItemGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
</Project>
