<Window x:Class="Unskip.App.Views.UrgentAttentionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l10n="clr-namespace:Unskip.App.Localization"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="{l10n:Localize UrgentPreviewTitle}"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        Background="#D9000000"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        KeyboardNavigation.TabNavigation="Cycle"
        automation:AutomationProperties.Name="{l10n:Localize UrgentPreviewAutomation}"
        Loaded="OnLoaded"
        Closed="OnClosed">
  <Window.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    <KeyBinding Key="F4" Modifiers="Alt" Command="{Binding CloseCommand}" />
  </Window.InputBindings>

  <Grid>
    <Border x:Name="MessageCard"
            Width="720"
            MaxWidth="800"
            MaxHeight="620"
            Margin="32"
            Padding="46"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="2"
            CornerRadius="22"
            automation:AutomationProperties.Name="{l10n:Localize UrgentMessageCardAutomation}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding SenderLabel}"
                   Foreground="{DynamicResource AccentDarkBrush}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   automation:AutomationProperties.Name="{l10n:Localize MessageSenderPreviewStatusAutomation}" />

        <ScrollViewer x:Name="MessageScroller"
                      Grid.Row="1"
                      Margin="0,24,0,0"
                      MaxHeight="360"
                      VerticalScrollBarVisibility="Auto">
          <TextBlock Text="{Binding Message}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     FontSize="34"
                     FontWeight="SemiBold"
                     LineHeight="46"
                     TextWrapping="Wrap"
                     automation:AutomationProperties.Name="{l10n:Localize UrgentMessageTextAutomation}" />
        </ScrollViewer>

        <Button x:Name="CloseButton"
                Grid.Row="2"
                Margin="0,34,0,0"
                MinWidth="190"
                MinHeight="50"
                HorizontalAlignment="Right"
                Content="{l10n:Localize CloseMessage}"
                Command="{Binding CloseCommand}"
                IsDefault="True"
                Padding="22,12"
                Background="{DynamicResource AccentBrush}"
                Foreground="White"
                BorderThickness="0"
                FontSize="15"
                FontWeight="SemiBold"
                automation:AutomationProperties.Name="{l10n:Localize ClosePreviewAutomation}"
                ToolTip="{l10n:Localize ClosePreviewTooltip}" />
      </Grid>
    </Border>
  </Grid>
</Window>
