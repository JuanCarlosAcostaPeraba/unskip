<UserControl x:Class="Unskip.App.Views.SendHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l10n="clr-namespace:Unskip.App.Localization"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             Background="Transparent">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.1*" MinWidth="430" />
      <ColumnDefinition Width="24" />
      <ColumnDefinition Width="0.9*" MinWidth="350" />
    </Grid.ColumnDefinitions>

    <Border Style="{DynamicResource CardStyle}" Padding="20">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{l10n:Localize LocalSendHistory}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="19" FontWeight="SemiBold" />
            <TextBlock Text="{Binding CountLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
          </StackPanel>
          <Button Grid.Column="1" Content="{l10n:Localize ClearHistory}" Command="{Binding ClearCommand}"
                  Style="{DynamicResource DangerButtonStyle}" automation:AutomationProperties.Name="{l10n:Localize ClearHistoryAutomation}" />
        </Grid>
        <Grid Grid.Row="1" Margin="0,18,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
          <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource FieldTextBoxStyle}"
                   automation:AutomationProperties.Name="{l10n:Localize SearchHistoryAutomation}" ToolTip="{l10n:Localize SearchHistoryPlaceholder}" />
          <ComboBox Grid.Column="2" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
                    DisplayMemberPath="Label" Padding="10,7" automation:AutomationProperties.Name="{l10n:Localize FilterHistoryAutomation}" />
        </Grid>
        <ListBox Grid.Row="2" ItemsSource="{Binding FilteredEntries}" SelectedItem="{Binding SelectedEntry}"
                 ItemContainerStyle="{DynamicResource DeviceItemStyle}" Background="Transparent" BorderThickness="0"
                 automation:AutomationProperties.Name="{l10n:Localize LocalSendHistoryEntriesAutomation}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding Alias}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Margin="0,4,0,0" Text="{Binding Destination}" Foreground="{DynamicResource AccentDarkBrush}" FontSize="13" />
                  <TextBlock Margin="0,7,0,0" Text="{Binding Timestamp}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                </StackPanel>
                <Border Grid.Column="1" Padding="9,5" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" VerticalAlignment="Top">
                  <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentDarkBrush}" FontSize="11" FontWeight="Bold" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Border Grid.Column="2" Style="{DynamicResource CardStyle}" Padding="22">
      <StackPanel>
        <TextBlock Text="{l10n:Localize HistoryDetails}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="19" FontWeight="SemiBold" />
        <TextBlock Margin="0,6,0,20" Text="{l10n:Localize HistorySnapshotHelp}"
                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding SelectedEntry.Alias}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="{Binding SelectedEntry.Destination}" Foreground="{DynamicResource AccentDarkBrush}" FontSize="16" FontWeight="SemiBold" />
        <Grid Margin="0,20,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="{l10n:Localize HistoryStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" /><TextBlock Text="{Binding SelectedEntry.Status}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" /></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="{l10n:Localize Duration}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" /><TextBlock Text="{Binding SelectedEntry.Duration}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" /></StackPanel>
        </Grid>
        <Border Margin="0,22,0,0" Padding="14" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="10">
          <StackPanel>
            <TextBlock Text="{l10n:Localize HistoryPrivacyBadge}" Foreground="{DynamicResource AccentDarkBrush}" FontSize="10" FontWeight="Bold" />
            <TextBlock Margin="0,6,0,0" Text="{Binding SelectedEntry.MessageSummary}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            <TextBlock Margin="0,6,0,0" Text="{l10n:Localize HistoryPrivacyHelp}"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <StackPanel Margin="0,24,0,0" Orientation="Horizontal">
          <Button Content="{l10n:Localize UseDestination}" Command="{Binding RetryCommand}" Style="{DynamicResource PrimaryButtonStyle}" />
          <Button Margin="10,0,0,0" Content="{l10n:Localize DeleteHistoryEntry}" Command="{Binding DeleteCommand}" Style="{DynamicResource DangerButtonStyle}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
