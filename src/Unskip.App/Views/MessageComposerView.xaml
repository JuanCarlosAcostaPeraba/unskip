<UserControl x:Class="Unskip.App.Views.MessageComposerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             Background="Transparent">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.15*" MinWidth="440" />
      <ColumnDefinition Width="24" />
      <ColumnDefinition Width="0.85*" MinWidth="340" />
    </Grid.ColumnDefinitions>

    <Border Style="{DynamicResource CardStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Your message"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,0"
                       Text="The draft stays here if Windows rejects the request or it times out."
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="12" />
          </StackPanel>
          <TextBlock Grid.Column="1"
                     Text="{Binding CharacterCountLabel}"
                     VerticalAlignment="Bottom">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsMessageOverLimit}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>

        <Border Grid.Row="1" Margin="0,20,0,18" Height="1" Background="{DynamicResource BorderBrush}" />

        <Grid Grid.Row="2">
          <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"
                   VerticalContentAlignment="Top"
                   Padding="16"
                   FontSize="16"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Background="{DynamicResource SurfaceMutedBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="1"
                   SpellCheck.IsEnabled="True"
                   automation:AutomationProperties.Name="Message text"
                   ToolTip="Enter up to 1,024 characters" />
          <TextBlock Margin="17"
                     Text="Write a clear, concise message..."
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     IsHitTestVisible="False"
                     VerticalAlignment="Top">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Message}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="{Binding MessageError}"
                     Style="{DynamicResource ErrorTextStyle}" />
          <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="←  Change destination"
                    Command="{Binding BackCommand}"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    automation:AutomationProperties.Name="Return to device selection" />
            <Button Grid.Column="1"
                    MinWidth="150"
                    Content="Send message  →"
                    Command="{Binding SendCommand}"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    automation:AutomationProperties.Name="Send the message using Windows" />
          </Grid>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="16" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Style="{DynamicResource CardStyle}" Padding="20">
        <StackPanel>
          <TextBlock Text="CONFIRM DESTINATION"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontSize="10"
                     FontWeight="Bold" />
          <TextBlock Margin="0,8,0,0"
                     Text="{Binding DestinationAlias}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     FontSize="22"
                     FontWeight="SemiBold" />
          <TextBlock Margin="0,4,0,0"
                     Text="{Binding Destination}"
                     Foreground="{DynamicResource AccentDarkBrush}"
                     FontSize="17"
                     FontWeight="SemiBold"
                     automation:AutomationProperties.Name="Resolved technical destination" />
          <TextBlock Text="{Binding DestinationKindLabel}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontSize="12" />
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="20">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Delivery status"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="17"
                       FontWeight="SemiBold" />
            <Border Grid.Column="1" Padding="10,5" Background="{DynamicResource AccentSoftBrush}" CornerRadius="9"
                    Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="{Binding StatusLabel}"
                         Foreground="{DynamicResource AccentDarkBrush}"
                         FontSize="11"
                         FontWeight="Bold" />
            </Border>
          </Grid>

          <ProgressBar Grid.Row="1" Margin="0,16,0,0" Height="4" IsIndeterminate="True"
                       Visibility="{Binding IsSending, Converter={StaticResource BooleanToVisibilityConverter}}" />

          <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="{Binding ResultMessage}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
            <Border Margin="0,18,0,0" Padding="14" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="10">
              <TextBlock Text="Windows can report whether it accepted the request, but Unskip cannot prove that a person saw, read, or acknowledged the message."
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         FontSize="12"
                         TextWrapping="Wrap" />
            </Border>
          </StackPanel>

          <StackPanel Grid.Row="3" Margin="0,18,0,0" VerticalAlignment="Bottom">
            <Button HorizontalAlignment="Left"
                    Content="Retry with this draft"
                    Command="{Binding RetryCommand}"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    Visibility="{Binding CanRetry, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Margin="0,12,0,0"
                    HorizontalAlignment="Left"
                    Content="Technical details"
                    Command="{Binding ToggleTechnicalDetailsCommand}"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Visibility="{Binding HasTechnicalDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Border Margin="0,10,0,0" Padding="12" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="8">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTechnicalDetailsExpanded}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBox Text="{Binding TechnicalDetails, Mode=OneWay}"
                       IsReadOnly="True"
                       TextWrapping="Wrap"
                       MaxHeight="140"
                       VerticalScrollBarVisibility="Auto"
                       BorderThickness="0"
                       Background="Transparent"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontFamily="Cascadia Mono, Consolas"
                       FontSize="11" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
