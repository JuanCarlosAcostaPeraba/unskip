<Project>
  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Authors>Unskip contributors</Authors>
    <Company>Unskip contributors</Company>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Copyright>Copyright © Unskip contributors</Copyright>
    <Description>Unofficial local-first Windows desktop messaging.</Description>
    <Deterministic>true</Deterministic>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <Product>Unskip</Product>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/JuanCarlosAcostaPeraba/unskip</RepositoryUrl>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>
</Project>
