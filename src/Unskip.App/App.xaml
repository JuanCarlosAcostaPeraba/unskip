<Application x:Class="Unskip.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F6F8" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#EAF0F3" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#102A2E" />
    <SolidColorBrush x:Key="SidebarMutedBrush" Color="#9CB4B5" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#14262A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#607277" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D8E1E3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0E8A83" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#086A65" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#DDF4F1" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B33A4A" />
  </Application.Resources>
</Application>
