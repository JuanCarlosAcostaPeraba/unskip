<UserControl x:Class="Unskip.App.Views.MessageComposerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l10n="clr-namespace:Unskip.App.Localization"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             Background="Transparent">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.35*" MinWidth="500" />
      <ColumnDefinition Width="20" />
      <ColumnDefinition Width="0.65*" MinWidth="300" />
    </Grid.ColumnDefinitions>

    <Border Style="{DynamicResource CardStyle}" Padding="20">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock HorizontalAlignment="Right"
                   Text="{Binding CharacterCountLabel}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsMessageOverLimit}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <Grid Grid.Row="1" Margin="0,12,0,0">
          <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"
                   VerticalContentAlignment="Top"
                   Padding="18"
                   FontSize="18"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Background="{DynamicResource SurfaceMutedBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="1"
                   SpellCheck.IsEnabled="True"
                   automation:AutomationProperties.Name="{l10n:Localize MessageTextAutomation}"
                   ToolTip="{l10n:Localize MessageCharacterLimitTooltip}" />
          <TextBlock Margin="19"
                     Text="{l10n:Localize MessageTextPlaceholder}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontSize="16"
                     IsHitTestVisible="False"
                     VerticalAlignment="Top">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Message}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="{Binding MessageError}"
                     Style="{DynamicResource ErrorTextStyle}" />
          <StackPanel Grid.Row="1"
                      Margin="0,10,0,0"
                      HorizontalAlignment="Right"
                      Orientation="Horizontal">
            <Button MinWidth="150"
                    Margin="0,0,10,0"
                    Content="{l10n:Localize Preview}"
                    Command="{Binding PreviewUrgentOverlayCommand}"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    automation:AutomationProperties.Name="{l10n:Localize PreviewAutomation}"
                    ToolTip="{l10n:Localize PreviewTooltip}" />
            <Button MinWidth="150"
                    Content="{l10n:Localize Send}"
                    Command="{Binding SendCommand}"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    automation:AutomationProperties.Name="{l10n:Localize SendAutomation}" />
          </StackPanel>
          <TextBlock Grid.Row="2"
                     Margin="0,8,0,0"
                     HorizontalAlignment="Right"
                     Text="{Binding PreviewStatus}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontSize="11"
                     TextWrapping="Wrap"
                     automation:AutomationProperties.Name="{l10n:Localize LocalPreviewStatusAutomation}" />
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Column="2"
            Style="{DynamicResource CardStyle}"
            Padding="20">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
          <TextBlock Text="{Binding DestinationAlias}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     FontSize="22"
                     FontWeight="SemiBold" />
          <TextBlock Margin="0,4,0,0"
                     Text="{Binding Destination}"
                     Foreground="{DynamicResource AccentDarkBrush}"
                     FontSize="16"
                     FontWeight="SemiBold"
                     automation:AutomationProperties.Name="{l10n:Localize ResolvedDestinationAutomation}" />
          <TextBlock Text="{Binding DestinationKindLabel}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontSize="11" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,18"
                Height="1"
                Background="{DynamicResource BorderBrush}" />

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding ResultMessage}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap" />
          <Border Grid.Column="1"
                  Margin="10,0,0,0"
                  Padding="9,4"
                  VerticalAlignment="Top"
                  Background="{DynamicResource AccentSoftBrush}"
                  CornerRadius="8"
                  Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding StatusLabel}"
                       Foreground="{DynamicResource AccentDarkBrush}"
                       FontSize="10"
                       FontWeight="Bold" />
          </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <ProgressBar Height="4"
                       IsIndeterminate="True"
                       Visibility="{Binding IsSending, Converter={StaticResource BooleanToVisibilityConverter}}" />

          <TextBlock Grid.Row="1"
                     Margin="0,14,0,0"
                     Text="{l10n:Localize NativeAcceptanceDisclaimer}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontSize="11"
                     TextWrapping="Wrap" />

          <StackPanel Grid.Row="2"
                      Margin="0,18,0,0"
                      VerticalAlignment="Bottom">
            <Button HorizontalAlignment="Left"
                    Content="{l10n:Localize Retry}"
                    Command="{Binding RetryCommand}"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    Visibility="{Binding CanRetry, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    Content="{l10n:Localize TechnicalDetails}"
                    Command="{Binding ToggleTechnicalDetailsCommand}"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Visibility="{Binding HasTechnicalDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Border Margin="0,10,0,0"
                    Padding="12"
                    Background="{DynamicResource SurfaceMutedBrush}"
                    CornerRadius="8">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTechnicalDetailsExpanded}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBox Text="{Binding TechnicalDetails, Mode=OneWay}"
                       IsReadOnly="True"
                       TextWrapping="Wrap"
                       MaxHeight="140"
                       VerticalScrollBarVisibility="Auto"
                       BorderThickness="0"
                       Background="Transparent"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontFamily="Cascadia Mono, Consolas"
                       FontSize="11" />
            </Border>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
