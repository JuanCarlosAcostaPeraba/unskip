<Window x:Class="Unskip.App.Views.QuickSendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l10n="clr-namespace:Unskip.App.Localization"
        Title="{l10n:Localize QuickWindowTitle}"
        Width="620"
        Height="720"
        MinWidth="620"
        MinHeight="720"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        AutomationProperties.Name="{l10n:Localize QuickWindowAutomation}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{l10n:Localize QuickHeading}"
                   FontSize="28"
                   FontWeight="SemiBold" />
        <TextBlock Text="{l10n:Localize QuickDescription}"
                   Margin="0,5,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>
      <Button Grid.Column="1"
              Content="{l10n:Localize QuickOpenFull}"
              Command="{Binding OpenMainWindowCommand}"
              Padding="14,8"
              AutomationProperties.Name="{l10n:Localize QuickOpenFullAutomation}" />
    </Grid>

    <Border Grid.Row="1"
            Margin="0,20,0,0"
            Padding="16"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
      <StackPanel>
        <TextBlock Text="{l10n:Localize QuickSavedDevice}"
                   FontWeight="SemiBold" />
        <ComboBox Margin="0,8,0,0"
                  ItemsSource="{Binding Devices}"
                  SelectedItem="{Binding SelectedDevice}"
                  DisplayMemberPath="Alias"
                  MinHeight="38"
                  AutomationProperties.Name="{l10n:Localize QuickSavedDeviceAutomation}" />
        <TextBlock Text="{l10n:Localize QuickOrOneTime}"
                   Margin="0,12,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Text="{Binding ManualDestination, UpdateSourceTrigger=PropertyChanged}"
                   MinHeight="38"
                   Padding="10,7"
                   AutomationProperties.Name="{l10n:Localize OneTimeDestinationAutomation}" />
          <Button Grid.Column="1"
                  Margin="8,0,0,0"
                  Content="{l10n:Localize Use}"
                  Command="{Binding UseManualDestinationCommand}"
                  Padding="18,8" />
        </Grid>
        <TextBlock Text="{Binding DestinationError}"
                   Margin="0,6,0,0"
                   Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding StatusMessage}"
                   Margin="0,8,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2"
            Margin="0,12,0,0"
            Padding="14"
            Background="{DynamicResource AccentSoftBrush}"
            CornerRadius="10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{l10n:Localize QuickResolvedDestination}"
                     FontSize="11"
                     FontWeight="Bold"
                     Foreground="{DynamicResource AccentDarkBrush}" />
          <TextBlock Text="{Binding Composer.DestinationAlias}"
                     Margin="0,4,0,0"
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding Composer.Destination}"
                     Foreground="{DynamicResource AccentDarkBrush}" />
        </StackPanel>
        <TextBlock Grid.Column="1"
                   Text="{Binding Composer.DestinationKindLabel}"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </Grid>
    </Border>

    <Border Grid.Row="3"
            Margin="0,12,0,0"
            Padding="16"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{l10n:Localize QuickMessage}"
                     FontWeight="SemiBold" />
          <TextBlock Grid.Column="1"
                     Text="{Binding Composer.CharacterCountLabel}"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </Grid>
        <TextBox Grid.Row="1"
                 Margin="0,8,0,0"
                 Text="{Binding Composer.Message, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Padding="10"
                 AutomationProperties.Name="{l10n:Localize QuickMessageAutomation}" />
        <TextBlock Grid.Row="2"
                   Text="{Binding Composer.MessageError}"
                   Margin="0,6,0,0"
                   Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap" />
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
          <TextBlock Text="{Binding Composer.StatusLabel}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentDarkBrush}" />
          <TextBlock Text="{Binding Composer.ResultMessage}"
                     Margin="0,3,0,0"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="4" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{l10n:Localize QuickResidentHint}"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
      <Button Grid.Column="1"
              Margin="8,0,0,0"
              Content="{l10n:Localize QuickRetry}"
              Command="{Binding Composer.RetryCommand}"
              Padding="16,9" />
      <Button Grid.Column="2"
              Margin="8,0,0,0"
              Content="{l10n:Localize QuickSend}"
              Command="{Binding Composer.SendCommand}"
              Padding="22,9"
              Background="{DynamicResource AccentBrush}"
              Foreground="White"
              AutomationProperties.Name="{l10n:Localize QuickSendAutomation}" />
    </Grid>
  </Grid>
</Window>
