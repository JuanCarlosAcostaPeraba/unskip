<Window x:Class="Unskip.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Unskip.App.ViewModels"
        mc:Ignorable="d"
        Title="Unskip"
        Width="960"
        Height="640"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">
  <Window.DataContext>
    <viewModels:MainWindowViewModel />
  </Window.DataContext>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Background="#17212B" Padding="28">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="{Binding ProductName}"
                     Foreground="White"
                     FontSize="28"
                     FontWeight="SemiBold" />
          <TextBlock Margin="0,8,0,32"
                     Text="Local Windows messaging"
                     Foreground="#AAB7C4"
                     FontSize="13" />
          <ItemsControl ItemsSource="{Binding NavigationItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="6" Background="#22303D">
                  <TextBlock Text="{Binding}" Foreground="#E8EDF2" FontSize="15" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom"
                   Text="Offline by design"
                   Foreground="#7F91A3"
                   FontSize="12" />
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="56,48">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock Text="{Binding CurrentSection}"
                   Foreground="#17212B"
                   FontSize="34"
                   FontWeight="SemiBold" />
        <TextBlock Margin="0,10,0,0"
                   Text="{Binding Tagline}"
                   Foreground="#536272"
                   FontSize="16" />
      </StackPanel>

      <Border Grid.Row="1"
              Margin="0,36,0,36"
              Padding="36"
              Background="White"
              BorderBrush="#DDE3E8"
              BorderThickness="1"
              CornerRadius="12">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="Foundation ready"
                     Foreground="#17212B"
                     FontSize="24"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
          <TextBlock Margin="0,12,0,0"
                     Text="{Binding StatusMessage}"
                     Foreground="#687786"
                     FontSize="14"
                     TextAlignment="Center" />
        </StackPanel>
      </Border>

      <TextBlock Grid.Row="2"
                 MaxWidth="620"
                 Text="{Binding AffiliationNotice}"
                 Foreground="#687786"
                 FontSize="12"
                 TextWrapping="Wrap" />
    </Grid>
  </Grid>
</Window>
